library(csarGeo)
library(terra)
library(ggplot2)
knitr::opts_chunk$set(
echo = TRUE,
fig.width = 7,
fig.height = 5,
out.width = "90%",
fig.align = "left",
warning = FALSE,
message = FALSE
)
# Load all example data files
data("species_data")
data("classes_clusters")
land_use <- load_landuse()
if ("csarGeo" %in% loadedNamespaces()) {
detach("package:csarGeo", unload = TRUE)
}
# 2. Delete the corrupted system installation
unlink("/Library/Frameworks/R.framework/Versions/4.6/Resources/library/csarGeo", recursive = TRUE)
# 3. Rebuild and install from your current project (source code)
devtools::install()
# 4. Load the freshly built package
library(csarGeo)
